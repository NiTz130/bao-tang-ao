  m_Script: {fileID: 11500000, guid: d34d9af03bd8a374c810bbfad858edf1, type: 3}
  m_Name: Info_Exhibit_01
  m_EditorClassIdentifier: Museum.Runtime::Museum.ExhibitInfo
  title: "T\u01B0\u1EE3ng Shiva kh\u1ED5 h\u1EA1nh"
  period: "Th\u1EBF k\u1EF7 XIV"
  material: "Sa th\u1EA1ch"
  origin: "L\xE0ng \u0110\u1EA1i H\u1EEFu, t\u1EC9nh B\xECnh \u0110\u1ECBnh (Ch\u0103m
    Pa)"
  source: "Statue of Shiva ascetic \u2014 michelon_e (Sketchfab), gi\u1EA5y ph\xE9p
    CC-BY 4.0. B\u1EA3n qu\xE9t 3D b\u1EB1ng ph\u01B0\u01A1ng ph\xE1p ch\u1EE5p \u1EA3nh
    (photogrammetry); k\xEDch th\u01B0\u1EDBc tr\u01B0ng b\xE0y l\xE0 \u01B0\u1EDBc
    l\u01B0\u1EE3ng."
  summary: "T\u01B0\u1EE3ng th\u1EA7n Shiva b\u1EB1ng sa th\u1EA1ch c\u1EE7a ng\u01B0\u1EDDi
    Ch\u0103m, t\xECm th\u1EA5y \u1EDF l\xE0ng \u0110\u1EA1i H\u1EEFu, t\u1EC9nh
    B\xECnh \u0110\u1ECBnh v\xE0o \u0111\u1EA7u th\u1EBF k\u1EF7 XX. T\u01B0\u1EE3ng
    thu\u1ED9c giai \u0111o\u1EA1n mu\u1ED9n c\u1EE7a ngh\u1EC7 thu\u1EADt Ch\u0103m,
    th\u1EBF k\u1EF7 XIV."
  story: "Ch\u0103m Pa l\xE0 v\u01B0\u01A1ng qu\u1ED1c c\u1EE7a ng\u01B0\u1EDDi Ch\u0103m
    \u1EDF mi\u1EC1n Trung v\xE0 mi\u1EC1n Nam Vi\u1EC7t Nam ng\xE0y nay. V\u01B0\u01A1ng
    qu\u1ED1c n\xE0y t\u1ED3n t\u1EA1i qua nhi\u1EC1u th\u1EBF k\u1EF7, \u0111\u1EBFn
    th\u1EBF k\u1EF7 XV.\n\nT\u01B0\u1EE3ng \u0111\u01B0\u1EE3c ph\xE1t hi\u1EC7n
    \u1EDF l\xE0ng \u0110\u1EA1i H\u1EEFu, t\u1EC9nh B\xECnh \u0110\u1ECBnh v\xE0o
    \u0111\u1EA7u th\u1EBF k\u1EF7 XX. \u0110\xE2y l\xE0 m\u1ED9t trong nh\u1EEFng
    t\xE1c ph\u1EA9m \u0111i\xEAu kh\u1EAFc Ch\u0103m n\u1ED5i b\u1EADt nh\u1EA5t.
    T\u01B0\u1EE3ng thu\u1ED9c giai \u0111o\u1EA1n mu\u1ED9n, th\u1EBF k\u1EF7 XIV.
    \u1EDE giai \u0111o\u1EA1n n\xE0y, ngh\u1EC7 nh\xE2n Ch\u0103m ch\xFA tr\u1ECDng
    c\xE1ch \u0111i\u1EC7u h\xECnh kh\u1ED1i h\u01A1n l\xE0 t\u1EA3 th\u1EF1c.\n\nShiva
    l\xE0 m\u1ED9t v\u1ECB th\u1EA7n ch\xEDnh c\u1EE7a \u1EA4n \u0110\u1ED9 gi\xE1o.
    T\u01B0\u1EE3ng th\u1EC3 hi\u1EC7n Shiva trong d\xE1ng v\u1EBB c\u1EE7a ng\u01B0\u1EDDi
    tu kh\u1ED5 h\u1EA1nh. Hi\u1EC7n v\u1EADt th\u1EADt \u0111ang \u0111\u01B0\u1EE3c
    tr\u01B0ng b\xE0y t\u1EA1i B\u1EA3o t\xE0ng L\u1ECBch s\u1EED Th\xE0nh ph\u1ED1
    H\u1ED3 Ch\xED Minh."
